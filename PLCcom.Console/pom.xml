<?xml version="1.0" encoding="UTF-8"?>
<!-- Self-contained module: the shared Swing console. No PLCcom MQTT dependency. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.indi-an.plccom</groupId>
    <artifactId>plccom-console</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>PLCcom Console</name>
    <description>Shared Swing console window used by the PLCcom MQTT workshops.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
        </plugins>
    </build>
</project>
